                ".validate": "newData.isString() && newData.val() === 'rain-primary'"
              },
              "epoch": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 10000"
              },
              "sequence": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 2147483647"
              },
              "observedAtMs": {
