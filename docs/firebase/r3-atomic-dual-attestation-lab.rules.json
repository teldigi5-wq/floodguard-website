          },
          "acceptance": {
            ".validate": "newData.hasChildren(['receipt','signature'])",
            "receipt": {
              ".validate": "newData.hasChildren(['version','stream','sourceAlias','epoch','sequence','payloadDigest','acceptedAtMs'])",
              "version": {
                ".validate": "newData.isString() && newData.val() === 'floodguard-r2-publisher-receipt-lab-v1'"
              },
              "stream": {
                ".validate": "newData.isString() && newData.val() === 'water'"
              },
              "sourceAlias": {
                ".validate": "newData.isString() && newData.val() === 'water-primary'"
              },
              "epoch": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 10000"
              },
              "sequence": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 2147483647"
              },
              "payloadDigest": {
                ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{64}$/)"
              },
              "acceptedAtMs": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 946684800000"
              },
