          ".validate": "newData.hasChildren(['report','acceptance']) && newData.child('report/payload/stream').val() === newData.child('acceptance/receipt/stream').val() && newData.child('report/payload/sourceAlias').val() === newData.child('acceptance/receipt/sourceAlias').val() && newData.child('report/payload/epoch').val() === newData.child('acceptance/receipt/epoch').val() && newData.child('report/payload/sequence').val() === newData.child('acceptance/receipt/sequence').val() && newData.child('report/payload/receivedAtMs').val() === newData.child('acceptance/receipt/acceptedAtMs').val()",
          "report": {
