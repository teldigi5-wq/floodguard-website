              },
              "sample": {
                ".validate": "newData.hasChildren(['distanceCm','levelCm','reportedStatus']) && newData.child('distanceCm').val() + newData.child('levelCm').val() >= 24.999 && newData.child('distanceCm').val() + newData.child('levelCm').val() <= 25.001",
                "distanceCm": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 25"
                },
                "levelCm": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 25"
                },
                "reportedStatus": {
                  ".validate": "newData.isString() && (newData.val() === 'SAFE' || newData.val() === 'WARNING' || newData.val() === 'DANGER' || newData.val() === 'SENSOR_ERROR')"
                },
                "$other": {
                  ".validate": false
                }
              },
              "$other": {
                ".validate": false
              }
            },
            "signature": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{86}$/)"
            },
            "$other": {
              ".validate": false
